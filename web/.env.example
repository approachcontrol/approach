# Full GraphQL endpoint URL of a running `approach serve`.
# Local dev:  http://127.0.0.1:8787/graphql
# Deployed:   https://<your-tunnel-host>/graphql
APPROACH_GRAPHQL_URL=http://127.0.0.1:8787/graphql

# Bearer token, required by `approach serve` on any non-loopback bind.
# Leave unset when pointing at a token-free loopback server.
# Never prefix this with NEXT_PUBLIC_ — it must stay server-side.
APPROACH_API_TOKEN=
